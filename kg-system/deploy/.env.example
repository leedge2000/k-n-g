# 复制为同目录的 .env 后填写。所有空白密钥均为必填，不要提交 .env。
# 为避免数据库/Elasticsearch URL 和 nGQL 转义问题，密码请仅使用字母、数字、点、下划线和连字符。
# NebulaGraph root 密码最长 24 个字符。
POSTGRES_DB=grainoil
POSTGRES_USER=grainoil
POSTGRES_PASSWORD=

KG_JWT_SECRET=
ELASTIC_PASSWORD=

MINIO_ROOT_USER=grainoil
MINIO_ROOT_PASSWORD=
KG_MINIO_BUCKET=grain-oil-docs

KG_NEBULA_USER=root
KG_NEBULA_PASSWORD=
KG_NEBULA_SPACE=grain_oil_kg

HTTP_PORT=8991
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
KG_CORS_ORIGINS=http://localhost:8991,http://127.0.0.1:8991
ES_JAVA_OPTS="-Xms1g -Xmx1g"
TZ=Asia/Shanghai
