  "SourceDoc_Segment": [
    {
      "docId": "SOU0001",
      "segmentId": "SOU0001-S001",
      "segmentNo": 1,
      "pageNo": 1,
      "chapterPath": "通知正文",
      "segmentText": "2025年国家继续在稻谷主产区实行最低收购价政策。综合考虑粮食生产成本、市场供求、国内外市场价格和产业发展等因素，经国务院批准，2025年生产的早籼稻、中晚籼稻和粳稻最低收购价分别为每50公斤128元、129元和131元。",
      "segmentType": "正文"
    },
    {
      "docId": "SOU0001",
      "segmentId": "SOU0001-S002",
      "segmentNo": 2,
      "pageNo": 1,
      "chapterPath": "通知正文/执行要求",
      "segmentText": "各地要加强对最低收购价政策执行情况的监督检查，切实保护种粮农民利益。",
      "segmentType": "正文"
    },
    {
      "docId": "SOU0002",
      "segmentId": "SOU0002-S001",
      "segmentNo": 1,
      "pageNo": 1,
      "chapterPath": "一、综合/农业",
      "segmentText": "全年粮食播种面积11932万公顷，比上年增加45万公顷。全年粮食产量70650万吨，比上年增加1109万吨，增产1.6%。",
      "segmentType": "正文"
    },
    {
      "docId": "SOU0002",
      "segmentId": "SOU0002-S002",
      "segmentNo": 2,
      "pageNo": 1,
      "chapterPath": "一、综合/农业",
      "segmentText": "其中，稻谷产量20753万吨，增产0.5%；小麦产量14010万吨，增产2.6%；玉米产量29492万吨，增产2.1%；大豆产量2065万吨，减产0.9%。",
      "segmentType": "正文"
    },
    {
      "docId": "SOU0003",
      "segmentId": "SOU0003-S001",
      "segmentNo": 1,
      "pageNo": 1,
      "chapterPath": "一、综合/农业",
      "segmentText": "全年粮食播种面积3047.87万亩，粮食总产量1100.73万吨。",
      "segmentType": "正文"
    },
    {
      "docId": "SOU0003",
      "segmentId": "SOU0003-S002",
      "segmentNo": 2,
      "pageNo": 1,
      "chapterPath": "一、综合/农业",
      "segmentText": "其中，稻谷产量492.07万吨，玉米产量261.00万吨，小麦产量6.12万吨。",
      "segmentType": "正文"
    },
    {
      "docId": "SOU0004",
      "segmentId": "SOU0004-S001",
      "segmentNo": 1,
      "pageNo": 1,
      "chapterPath": "World Rice Production/2026/27 Sep",
      "segmentText": "World rice production for 2026/27 Sep is 533,852 thousand metric tons, milled basis.",
      "segmentType": "正文"
    },
    {
      "docId": "SOU0004",
      "segmentId": "SOU0004-S002",
      "segmentNo": 2,
      "pageNo": 1,
      "chapterPath": "World Rice Production/China/2026/27 Sep",
      "segmentText": "China rice production for 2026/27 Sep is 147,000 thousand metric tons, milled basis.",
      "segmentType": "正文"
    }
  ],
