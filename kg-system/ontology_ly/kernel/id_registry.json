{
  "schemaVersion": "1.0",
  "stage": "Stage 0",
  "frozen": true,
  "sourceBaseline": "STAGE0-执行分解.md §4",
  "format": {
    "pattern": "<前缀>-<域码>-<语义片段>[-<限定>]",
    "regex": "^(OBJ|LNK|DIM|SCP|FAC|AST)-(PUB|S[1-7])-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
    "domainCodeRule": "第二段必须是 domainCodes 中的码（PUB 或 S1—S7），不允许自由填写",
    "semanticFragmentRule": "全大写；只允许 A-Z、0-9 与连字符；建议用英文短词或标准编码，长度 3—24；不得用中文、空格、下划线",
    "qualifierRule": "可选，用于同一语义的年度/地区/版本区分，如 -2024 / -CN / -V2",
    "immutable": "ID 一经写入即冻结，改义不改 ID；确需改义则新建对象并把旧 ID 记入 mergedIntoId 链"
  },
  "prefixes": [
    { "prefix": "OBJ", "label": "对象类型实例", "appliesTo": "25 个内核对象类型 + 9 个政策包条款类型" },
    { "prefix": "LNK", "label": "关系实体实例", "appliesTo": "4 个关系实体化类型" },
    { "prefix": "DIM", "label": "维度定义", "appliesTo": "Dimension（固定 10 条）" },
    { "prefix": "SCP", "label": "范围组合", "appliesTo": "Scope" },
    { "prefix": "FAC", "label": "因子", "appliesTo": "Factor" },
    { "prefix": "AST", "label": "断言", "appliesTo": "Assertion" },
    { "prefix": "TRM", "label": "术语种子", "appliesTo": "terms/ly_terms.json 的 100 条术语", "appliesToGateG0-2": false, "note": "词表条目，不是对象实例；不参与 format.regex 校验" },
    { "prefix": "FN", "label": "计算函数", "appliesTo": "kernel/functions.json 的 12 个 Function", "appliesToGateG0-2": false, "note": "函数签名标识，不是对象实例；形如 FN-<域码>-<函数名>" },
    { "prefix": "ACT", "label": "受控动作", "appliesTo": "kernel/actions.json 的 10 个 Action", "appliesToGateG0-2": false, "note": "动作标识，不是对象实例；形如 ACT-<域码>-<动作名>" }
  ],
  "nonInstanceNamespaces": {
    "note": "以下前缀不在 format.regex 内，不受门 G0-2 主键格式校验约束；其自身格式由各自交付物声明。",
    "items": [
      { "prefix": "TRM", "format": "^TRM-[A-Z]{2}-[0-9]{4}$", "example": "TRM-LY-0001", "source": "terms/ly_terms.json" },
      { "prefix": "FN", "format": "^FN-[A-Z]{2,4}-[A-Z0-9]+(?:-[A-Z0-9]+)*$", "example": "FN-PUB-CRUSH-MARGIN", "source": "kernel/functions.json" },
      { "prefix": "ACT", "format": "^ACT-[A-Z]{2,4}-[A-Z0-9]+(?:-[A-Z0-9]+)*$", "example": "ACT-PUB-WHATIF", "source": "kernel/actions.json" }
    ]
  },
  "domainCodes": [
    { "code": "PUB", "label": "共享内核", "owner": "kernel", "note": "所有跨包共享对象一律 PUB" },
    { "code": "S1", "label": "口粮", "owner": "pack", "note": "稻谷/小麦/成品粮消费与收购" },
    { "code": "S2", "label": "饲料粮", "owner": "pack", "note": "玉米/豆粕/饲料需求" },
    { "code": "S3", "label": "油脂油料", "owner": "pack", "note": "大豆/菜籽/棕榈/油脂" },
    { "code": "S4", "label": "政策与储备", "owner": "pack", "note": "含全部条款级 9 类型" },
    { "code": "S5", "label": "进出口与贸易", "owner": "pack", "note": "海关/关税/配额" },
    { "code": "S6", "label": "价格与期货", "owner": "pack", "note": "现货/期货/基差" },
    { "code": "S7", "label": "加工产业链", "owner": "pack", "note": "压榨/制粉/饲料加工" }
  ],
