main_unknown_stm_6171a6cf12a6223fa457a527a775a2bf(?c) :- main_cond_unknown_stm_6171a6cf12a6223fa457a527a775a2bf_0(?c), ~main_false_stm_6171a6cf12a6223fa457a527a775a2bf(?c) .
exception_false_stm_6171a6cf12a6223fa457a527a775a2bf(?c) :- case_exists(?c) .
fires(?c, "STM-6171a6cf12a6223fa457a527a775a2bf") :- case_exists(?c), main_true_stm_6171a6cf12a6223fa457a527a775a2bf(?c), exception_false_stm_6171a6cf12a6223fa457a527a775a2bf(?c) .
