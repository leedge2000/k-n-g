{
  "schemaVersion": "1.0",
  "note": "阶段 2 多条款情形的唯一事实来源。TC1~TC7 为阶段 0 基线（新增字段置空，验证单条款行为不变）；TC8~TC11 为优先级组合情形。expect 按条款短码给出期望结论。",
  "cases": [
    {
      "id": "TC1",
      "scenarioName": "基线：河南 7 月 1.15 三等 无地方收储 无省级细则",
      "region": "HENAN",
      "date": "2025-07-15",
      "price": 1.15,
      "grade": 3,
      "local_reserve_active": false,
      "province_rule_published": false,
      "emergency_level": null,
      "expect": { "S1": "APPLICABLE", "S2": "NOT_APPLICABLE", "S3": "NOT_APPLICABLE" },
      "expectReason": "S1 四前提成立且无例外；S2 未发布省级细则；S3 无应急响应"
    },
    {
      "id": "TC2",
      "scenarioName": "基线：到库价 1.25 高于最低收购价 1.19",
      "region": "HENAN",
      "date": "2025-07-15",
      "price": 1.25,
      "grade": 3,
      "local_reserve_active": false,
      "province_rule_published": false,
      "emergency_level": null,
      "expect": { "S1": "NOT_APPLICABLE", "S2": "NOT_APPLICABLE", "S3": "NOT_APPLICABLE" },
      "expectReason": "S1 的 C1-3 不成立；S2 未发布且价格亦高于 1.20"
    },
    {
      "id": "TC3",
      "scenarioName": "基线：广东不在 6 省执行区",
      "region": "GUANGDONG",
      "date": "2025-07-15",
      "price": 1.15,
      "grade": 3,
      "local_reserve_active": false,
      "province_rule_published": false,
      "emergency_level": null,
      "expect": { "S1": "NOT_APPLICABLE", "S2": "NOT_APPLICABLE", "S3": "NOT_APPLICABLE" },
      "expectReason": "S1 与 S2 的区域条件均不成立"
    },
    {
      "id": "TC4",
      "scenarioName": "基线：10 月超出执行期",
      "region": "HENAN",
      "date": "2025-10-15",
      "price": 1.15,
      "grade": 3,
      "local_reserve_active": false,
      "province_rule_published": false,
      "emergency_level": null,
      "expect": { "S1": "NOT_APPLICABLE", "S2": "NOT_APPLICABLE", "S3": "NOT_APPLICABLE" },
      "expectReason": "三条条款的时间窗条件均不成立"
    },
    {
      "id": "TC5",
      "scenarioName": "基线：到库价缺失",
      "region": "HENAN",
      "date": "2025-07-15",
      "price": null,
      "grade": 3,
      "local_reserve_active": false,
      "province_rule_published": false,
      "emergency_level": null,
      "expect": { "S1": "UNABLE", "S2": "UNABLE", "S3": "NOT_APPLICABLE" },
      "expectReason": "S1 与 S2 均缺 price；S3 条件不涉及 price，仅因无应急响应而不适用"
    },
    {
      "id": "TC6",
      "scenarioName": "基线：该省已启动地方收储",
      "region": "HENAN",
      "date": "2025-07-15",
      "price": 1.15,
      "grade": 3,
      "local_reserve_active": true,
      "province_rule_published": false,
      "emergency_level": null,
      "expect": { "S1": "NOT_APPLICABLE", "S2": "NOT_APPLICABLE", "S3": "NOT_APPLICABLE" },
      "expectReason": "S1 被例外 E1 排除（条款内例外，非条款间优先级）"
    },
    {
      "id": "TC7",
      "scenarioName": "基线：等级 4 等低于三等标准",
      "region": "HENAN",
      "date": "2025-07-15",
      "price": 1.15,
      "grade": 4,
      "local_reserve_active": false,
      "province_rule_published": false,
      "emergency_level": null,
      "expect": { "S1": "NOT_APPLICABLE", "S2": "NOT_APPLICABLE", "S3": "NOT_APPLICABLE" },
      "expectReason": "S1 与 S2 的质量条件均不成立"
    },
    {
      "id": "TC8",
      "scenarioName": "优先级：S1 与 S2 同时成立，S2 优先",
      "region": "HENAN",
      "date": "2025-07-15",
      "price": 1.15,
      "grade": 3,
      "local_reserve_active": false,
      "province_rule_published": true,
      "emergency_level": null,
      "expect": { "S1": "OVERRIDDEN", "S2": "APPLICABLE", "S3": "NOT_APPLICABLE" },
      "expectReason": "prevails(S2,S1)：S1 被 S2 覆盖，最终生效为 S2"
    },
    {
      "id": "TC9",
      "scenarioName": "优先级：三条同时成立，S3 经传递优先",
      "region": "HENAN",
      "date": "2025-07-15",
      "price": 1.15,
      "grade": 3,
      "local_reserve_active": false,
      "province_rule_published": true,
      "emergency_level": 2,
      "expect": { "S1": "OVERRIDDEN", "S2": "OVERRIDDEN", "S3": "APPLICABLE" },
      "expectReason": "prevails(S3,S2) 与 prevails(S2,S1) 经传递闭包得 S3>S1，最终生效为 S3"
    },
    {
      "id": "TC10",
      "scenarioName": "优先级：缺事实不可被覆盖",
      "region": "HENAN",
      "date": "2025-07-15",
      "price": null,
      "grade": 3,
      "local_reserve_active": false,
      "province_rule_published": true,
      "emergency_level": null,
      "expect": { "S1": "UNABLE", "S2": "UNABLE", "S3": "NOT_APPLICABLE" },
      "expectReason": "S1/S2 缺 price 均为 UNABLE；S2 自身 UNABLE，无权覆盖 S1"
    },
    {
      "id": "TC11",
      "scenarioName": "优先级：价格落在 S1 与 S2 门槛之间",
      "region": "HENAN",
      "date": "2025-07-15",
      "price": 1.195,
      "grade": 3,
      "local_reserve_active": false,
      "province_rule_published": true,
      "emergency_level": null,
      "expect": { "S1": "NOT_APPLICABLE", "S2": "APPLICABLE", "S3": "NOT_APPLICABLE" },
      "expectReason": "1.195 ≥ 1.19 故 S1 不成立；1.195 < 1.20 故 S2 单独适用"
    }
  ]
}
