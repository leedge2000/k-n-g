        {
          "caseId": "S2-SAF-008",
          "title": "Nemo 异常不得静默 fallback",
          "setup": "engine_failure",
          "asOf": "2025-06-01",
          "facts": {"targetObject": "早籼稻"},
          "targetClauseId": "POL0001-C001",
          "expectedOutcome": "UNABLE",
          "expectedReasonContains": "Nemo"
        },
        {
          "caseId": "S2-SAF-009",
          "title": "缺完整证明链必须降级",
          "setup": "missing_proof_chain",
          "asOf": "2025-06-01",
