    "syntheticSafety": {
      "title": "合成安全情形",
      "cases": [
        {
          "caseId": "S2-SAF-001",
          "title": "集合比较缺事实",
          "setup": "collection_missing",
          "asOf": "2025-06-01",
          "facts": {"targetObject": "早籼稻"},
          "targetClauseId": "POL0001-C001",
          "expectedOutcome": "UNABLE",
          "expectedReasonContains": "缺事实"
        },
        {
          "caseId": "S2-SAF-002",
          "title": "非法数值不可猜成条件为假",
          "setup": "invalid_numeric",
          "asOf": "2025-06-01",
          "facts": {"targetObject": "早籼稻", "price": "not-a-number"},
          "targetClauseId": "POL0001-C001",
          "expectedOutcome": "UNABLE",
          "expectedReasonContains": "不可求值"
        },
        {
          "caseId": "S2-SAF-003",
          "title": "未知比较符返回 UNABLE",
          "setup": "unknown_comparator",
          "asOf": "2025-06-01",
          "facts": {"targetObject": "早籼稻"},
          "targetClauseId": "POL0001-C001",
          "expectedOutcome": "UNABLE",
          "expectedReasonContains": "不可求值"
        },
        {
          "caseId": "S2-SAF-004",
          "title": "主条件为真但例外未知",
          "setup": "exception_unknown",
          "asOf": "2025-06-01",
          "facts": {"targetObject": "早籼稻"},
          "targetClauseId": "POL0001-C001",
          "expectedOutcome": "UNABLE",
          "expectedReasonContains": "例外"
        },
        {
          "caseId": "S2-SAF-005",
          "title": "高优先级规则覆盖",
          "setup": "priority_override",
          "asOf": "2025-06-01",
          "facts": {"targetObject": "早籼稻"},
          "targetClauseId": "POL0001-C001",
          "expectedOutcome": "NOT_APPLICABLE",
          "expectedReasonContains": "覆盖"
        },
        {
          "caseId": "S2-SAF-006",
          "title": "优先级成环不得强行裁决",
          "setup": "priority_cycle",
          "asOf": "2025-06-01",
          "facts": {"targetObject": "早籼稻"},
          "targetClauseId": "POL0001-C001",
          "expectedOutcome": "UNABLE",
          "expectedReasonContains": "成环"
        },
        {
          "caseId": "S2-SAF-007",
          "title": "同条款多 statement 不折叠",
          "setup": "multi_statement",
          "asOf": "2025-06-01",
